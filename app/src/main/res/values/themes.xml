<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme locked to pure dark -->
    <style name="Theme.Clockity" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Fullscreen Alarm Ringing Theme -->
    <style name="Theme.Clockity.FullscreenAlarm" parent="Theme.Clockity">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
